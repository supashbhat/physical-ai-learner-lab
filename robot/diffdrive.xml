<mujoco model="field-notes differential drive">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.03" armature="0.002"/>
    <geom condim="3" friction="1.2 0.04 0.002" solref="0.01 1" solimp="0.92 0.98 0.002"/>
  </default>

  <worldbody>
    <light name="key" pos="1 -2 4" dir="-0.2 0.3 -1" diffuse="0.9 0.88 0.8"/>
    <light name="fill" pos="-3 2 2" dir="0.5 -0.2 -1" diffuse="0.35 0.48 0.65"/>
    <geom name="floor" type="plane" size="12 12 0.1" rgba="0.13 0.16 0.20 1"/>

    <geom name="north_wall" type="box" pos="0.5 1.48 0.34" size="2.1 0.06 0.34"
          rgba="0.16 0.34 0.37 1"/>
    <geom name="south_wall" type="box" pos="0.5 -1.48 0.34" size="2.1 0.06 0.34"
          rgba="0.20 0.28 0.36 1"/>
    <geom name="east_wall" type="box" pos="2.54 0 0.34" size="0.06 1.42 0.34"
          rgba="0.31 0.28 0.39 1"/>
    <geom name="west_wall" type="box" pos="-1.54 0 0.34" size="0.06 1.42 0.34"
          rgba="0.20 0.33 0.39 1"/>
    <geom name="north_marker_a" type="box" pos="-0.8 1.405 0.28" size="0.11 0.015 0.28"
          rgba="0.92 0.45 0.26 1"/>
    <geom name="north_marker_b" type="box" pos="0.55 1.405 0.28" size="0.11 0.015 0.28"
          rgba="0.79 0.69 0.40 1"/>
    <geom name="east_marker" type="box" pos="2.465 -0.75 0.28" size="0.015 0.11 0.28"
          rgba="0.36 0.62 0.78 1"/>

    <body name="base" pos="0 0 0.13">
      <freejoint name="base_free"/>
      <geom name="chassis" type="box" size="0.13 0.092 0.038" mass="2.1"
            rgba="0.16 0.62 0.59 1"/>
      <geom name="top_plate" type="box" pos="-0.005 0 0.043" size="0.085 0.070 0.008"
            mass="0.08" rgba="0.88 0.89 0.84 1"/>
      <geom name="front_bumper" type="box" pos="0.127 0 0.004" size="0.012 0.078 0.014"
            mass="0.03" rgba="0.92 0.45 0.26 1"/>

      <camera name="front_camera" pos="0.155 0 0.055"
              xyaxes="0 -1 0 0 0 1" fovy="62"/>
      <site name="lidar_origin" pos="0.09 0 0.018" size="0.006"
            rgba="0.98 0.76 0.30 1"/>

      <body name="left_wheel" pos="0 0.108 -0.075">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="left_tire" type="cylinder" size="0.055 0.018"
              quat="0.70710678 0.70710678 0 0" mass="0.16"
              friction="1.8 0.08 0.004" rgba="0.08 0.09 0.11 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.108 -0.075">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="right_tire" type="cylinder" size="0.055 0.018"
              quat="0.70710678 0.70710678 0 0" mass="0.16"
              friction="1.8 0.08 0.004" rgba="0.08 0.09 0.11 1"/>
      </body>

      <geom name="rear_skid" type="sphere" pos="-0.105 0 -0.105" size="0.025"
            mass="0.025" friction="0.06 0.01 0.001" rgba="0.92 0.45 0.26 1"/>
      <geom name="front_skid" type="sphere" pos="0.105 0 -0.095" size="0.025"
            mass="0.025" friction="0.06 0.01 0.001" rgba="0.92 0.45 0.26 1"/>
    </body>

    <body name="obstacle_a" pos="1.15 0.48 0.22">
      <freejoint/>
      <geom type="box" size="0.22 0.08 0.22" mass="20" rgba="0.92 0.45 0.26 1"/>
    </body>
    <body name="obstacle_b" pos="1.85 -0.42 0.16">
      <freejoint/>
      <geom type="cylinder" size="0.15 0.16" mass="15" rgba="0.88 0.68 0.31 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_drive" joint="left_wheel_joint" gear="1" ctrlrange="-1.8 1.8"/>
    <motor name="right_drive" joint="right_wheel_joint" gear="1" ctrlrange="-1.8 1.8"/>
  </actuator>
</mujoco>
